# Copiar a .env y completar con los valores reales.
# .env esta en .gitignore y NUNCA se commitea. Este archivo si, para que se
# sepa que variables hay que setear (con valores de mentira).

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/truchoprode
DB_USER=truchoprode
DB_PASSWORD=poner-la-password-aca

# --- JWT ---
# Minimo 32 caracteres. Generar uno nuevo, no reutilizar este.
JWT_SECRET=generar-un-secreto-largo-y-aleatorio-de-32-caracteres-o-mas
JWT_EXPIRACION_MINUTOS=120

# --- Otros ---
CORS_ORIGENES=http://localhost:5173
SERVER_PORT=8080
